          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT path) AS \"FR product URLs Google could not crawl\"\nFROM access_logs\nWHERE $__timeFilter(ts)\n  AND bot_family = 'googlebot'\n  AND is_verified_bot\n  AND cdn_rule_id IS NOT NULL",
          "datasource": {
            "type": "grafana-postgresql-datasource",
