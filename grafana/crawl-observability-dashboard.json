    {
      "type": "state-timeline",
      "id": 9,
      "title": "Googlebot crawl health by market",
      "description": "Hourly crawl success rate of legitimate Googlebot on product pages, per market. Healthy: 85 % and above. Degraded: 50 to 85 %. Blocked: below 50 %. Hourly samples are small (30 to 50 requests per market): isolated orange cells reflect random errors.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(ts, '1h'),\n  upper(market) AS metric,\n  100.0 * count(*) FILTER (WHERE status < 400) / count(*) AS value\nFROM access_logs\nWHERE $__timeFilter(ts)\n  AND page_type = 'product'\n  AND bot_family = 'googlebot'\n  AND is_verified_bot\nGROUP BY 1, 2\nORDER BY 1, 2",
          "datasource": {
