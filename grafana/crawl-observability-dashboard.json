  "panels": [
    {
      "type": "text",
      "id": 1,
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "### Incident review: Googlebot blocked on www&#46;example&#46;fr product pages\nA bot-mitigation rule (`CDN-FR-0412`) matched the Googlebot user agent without verifying the IP, and blocked Google's crawler for 28.5 hours. Scope: verified Googlebot on French product pages, compared with the German, British and US sites.\n\n<small>Synthetic data: AWS sample web server logs and a simulated crawl layer \u00b7 18 to 22 March 2024, UTC \u00b7 Vertical markers show CDN changes</small>"
      }
    },
    {
      "type": "row",
      "id": 2,
      "title": "Executive overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 3,
      "title": "FR crawl health, latest hour",
      "description": "Share of legitimate Googlebot requests (IP inside Google's ranges) on French product pages answered with a status below 400, over the latest hour. Sparkline: hourly values over the whole period.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(ts, '1h'),\n  100.0 * count(*) FILTER (WHERE status < 400) / count(*) AS \"Crawl success rate\"\nFROM access_logs\nWHERE $__timeFilter(ts)\n  AND host = 'www.example.fr'\n  AND page_type = 'product'\n  AND bot_family = 'googlebot'\n  AND is_verified_bot\nGROUP BY 1\nORDER BY 1",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 50,
                "color": "orange"
              },
              {
                "value": 85,
                "color": "green"
              }
            ]
          },
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Legitimate Googlebot requests blocked",
      "description": "Requests from verified Google IP ranges rejected by rule CDN-FR-0412 during the selected period.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Legitimate Googlebot requests blocked\"\nFROM access_logs\nWHERE $__timeFilter(ts)\n  AND bot_family = 'googlebot'\n  AND is_verified_bot\n  AND cdn_rule_id IS NOT NULL",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          }
        }
      ],
      "fieldConfig": {
