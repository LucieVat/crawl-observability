    {
      "type": "stat",
      "id": 6,
      "title": "Incident duration",
      "description": "Time between the deployment of CDN-FR-0412 v1 and the fix (v2), read from the change log.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 18,
