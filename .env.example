# Copy this file to .env and fill in the values.
# .env stays on your computer: it is listed in .gitignore and never goes to GitHub.

# --- Option A: run everything locally with Docker (docker compose up -d) ---
# Use letters and digits only (e.g. openssl rand -hex 20): the Postgres password goes into a connection URL.
POSTGRES_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me-too
GRAFANA_ADMIN_PASSWORD=change-me-as-well
# GRAFANA_ROOT_URL=https://grafana.example.com
# GRAFANA_PORT=3000          # port on the host, bound to 127.0.0.1

# --- Option B: load the data into a hosted PostgreSQL (e.g. Neon) from your computer ---
# Then run: python ingest/ingest.py
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
