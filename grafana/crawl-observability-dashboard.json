    {
      "type": "timeseries",
      "id": 11,
      "title": "Googlebot traffic on FR product pages: legitimate vs spoofed",
      "description": "Requests per hour whose user agent claims to be Googlebot. Legitimate: IP inside Google's published ranges. Spoofed: IP outside them.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(ts, '1h'),\n  CASE WHEN is_verified_bot THEN 'Legitimate Googlebot (verified IP)'\n       ELSE 'Spoofed Googlebot (IP outside Google ranges)' END AS metric,\n  count(*) AS value\nFROM access_logs\nWHERE $__timeFilter(ts)\n  AND host = 'www.example.fr'\n  AND page_type = 'product'\n  AND bot_family = 'googlebot'\nGROUP BY 1, 2\nORDER BY 1, 2",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 85,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Legitimate Googlebot (verified IP)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Spoofed Googlebot (IP outside Google ranges)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
