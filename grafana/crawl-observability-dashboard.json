        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM\n  max(event_time) FILTER (WHERE event_type = 'cdn_fix')\n  - max(event_time) FILTER (WHERE event_type = 'cdn_deploy')\n) AS \"Incident duration\"\nFROM change_events",
          "datasource": {
